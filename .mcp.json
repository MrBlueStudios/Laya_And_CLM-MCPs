{
  "mcpServers": {
    "laya-mcp-server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}/laya-mcp-server",
        "--frozen",
        "--quiet",
        "laya-decision-mcp"
      ],
      "env": {
        "LAYA_MCP_MODEL": "auto",
        "LAYA_MCP_PRELOAD": "english"
      }
    },
    "clm-mcp-server": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PROJECT_DIR:-.}/clm-mcp-server",
        "--frozen",
        "--quiet",
        "clm-decision-mcp"
      ],
      "env": {
        "CLM_BASE_URL": "${CLM_BASE_URL:-http://127.0.0.1:8700}",
        "CLM_API_KEY": "${CLM_API_KEY:-}"
      }
    }
  }
}
